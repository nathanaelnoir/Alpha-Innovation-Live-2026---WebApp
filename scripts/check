#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_database_url="${TEST_DATABASE_URL:-postgresql+psycopg://lab@127.0.0.1:55432/conference_survey_test}"

if ! "${project_dir}/backend/scripts/local-postgres" status >/dev/null 2>&1; then
    "${project_dir}/backend/scripts/local-postgres" start
fi

(
    cd "${project_dir}/backend"
    .venv/bin/ruff check .
    .venv/bin/ruff format --check .
    .venv/bin/mypy app
    TEST_DATABASE_URL="${test_database_url}" .venv/bin/pytest
    .venv/bin/alembic upgrade head
    .venv/bin/alembic check
)

(
    cd "${project_dir}/frontend"
    npm run lint
    npm run test
    npm run build
)

(
    cd "${project_dir}/presentation"
    npm run build
)
